# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Google Ads / Analytics (Vite public env — exposed to the browser) ---
# Prefer GTM. If VITE_GTM_ID is set, gtag is NOT loaded directly (avoid double hits).
# Create tags in GTM that listen for dataLayer events:
#   generate_lead   = primary lead (form submit → WhatsApp with filled details)
#   whatsapp_click  = secondary (raw WhatsApp tap)
#   phone_click     = secondary (click-to-call)
VITE_GTM_ID="GTM-MBLWPDXJ"

# Direct gtag fallback (only used when VITE_GTM_ID is empty):
VITE_GA4_MEASUREMENT_ID=""
VITE_GOOGLE_ADS_ID=""

# Optional Google Ads conversion send_to values (format: AW-XXXXXXXXX/YYYYYYYYYYY)
# Only needed for direct gtag mode. With GTM, configure conversions inside GTM instead.
VITE_ADS_CONVERSION_LEAD=""
VITE_ADS_CONVERSION_WHATSAPP=""
VITE_ADS_CONVERSION_PHONE=""
